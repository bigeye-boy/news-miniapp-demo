/* Account page layout. */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 108rpx 32rpx 72rpx;
}

.profile-heading {
  margin-bottom: 24rpx;
}

.section-label {
  display: block;
  color: #718078;
  font-size: calc(18rpx * var(--host-font-scale, 1));
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.profile-heading-title {
  display: block;
  margin-top: 8rpx;
  color: #16221f;
  font-size: calc(46rpx * var(--host-font-scale, 1));
  font-weight: 750;
}

/* Dark theme text colors for profile content. */
.page.theme-dark .profile-heading-title,
.page.theme-dark .theme-title,
.page.theme-dark .section-title {
  color: #f4f7f5;
}

.page.theme-dark .theme-value {
  color: #8ed0a4;
}

/* Profile summary card. */
.profile-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid #dce5df;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(35, 57, 45, 0.05);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #dcece1;
}

.placeholder {
  color: #2d7950;
  font-size: calc(54rpx * var(--host-font-scale, 1));
  line-height: 128rpx;
  text-align: center;
}

.profile-copy {
  margin-left: 24rpx;
}

.edit-button {
  width: 72rpx;
  height: 72rpx;
  margin: 0 0 0 auto;
  padding: 0;
  border: 1rpx solid #cbd9d0;
  border-radius: 50%;
  color: #2d7950;
  background: #f5faf6;
  line-height: 72rpx;
}

.edit-icon {
  font-size: 38rpx;
  line-height: 1;
}

.title,
.desc {
  display: block;
}

.title {
  color: #16221f;
  font-size: calc(42rpx * var(--host-font-scale, 1));
  font-weight: 700;
}

.desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: calc(28rpx * var(--host-font-scale, 1));
}

.updated {
  display: block;
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: calc(20rpx * var(--host-font-scale, 1));
}

/* Third-party notification switch. */
.notification-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #dce5df;
  border-radius: 18rpx;
  background: #ffffff;
}

.notification-title,
.notification-desc {
  display: block;
}

.notification-title {
  color: #27372e;
  font-size: calc(28rpx * var(--host-font-scale, 1));
  font-weight: 600;
}

.notification-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: calc(22rpx * var(--host-font-scale, 1));
}

/* Appearance settings card. */
.settings {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid #dce5df;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(35, 57, 45, 0.03);
}

.section-title,
.theme-title,
.theme-desc,
.theme-value {
  display: block;
}

.section-title {
  margin-top: 10rpx;
  color: #27372e;
  font-size: calc(32rpx * var(--host-font-scale, 1));
  font-weight: 700;
}

.theme-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e1e9e3;
}

.theme-title {
  color: #27372e;
  font-size: calc(28rpx * var(--host-font-scale, 1));
  font-weight: 600;
}

.theme-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: calc(22rpx * var(--host-font-scale, 1));
}

.theme-value {
  margin-left: 20rpx;
  color: #2d7950;
  font-size: calc(24rpx * var(--host-font-scale, 1));
  text-align: right;
}

.page.theme-dark .notification-section {
  border-color: #33453b;
  background: #18231f;
}

.page.theme-dark .notification-title {
  color: #f4f7f5;
}

.page.theme-dark .notification-desc {
  color: #b9c8c0;
}

/* Components consumed from the local npm package. */
.npm-components {
  margin-top: 20rpx;
}

.npm-card-content {
  margin-top: 8rpx;
}

.npm-card-header {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.npm-stepper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
}

.npm-stepper-title,
.npm-stepper-desc {
  display: block;
}

.npm-stepper-title {
  color: #27372e;
  font-size: calc(28rpx * var(--host-font-scale, 1));
  font-weight: 600;
}

.npm-stepper-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: calc(22rpx * var(--host-font-scale, 1));
}

.page.theme-dark .npm-stepper-title {
  color: #f4f7f5;
}

.page.theme-dark .npm-stepper-desc {
  color: #b9c8c0;
}

/* Drawer demo and slot content. */
.drawer-demo {
  margin-top: 20rpx;
}

.drawer-content-desc {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: calc(22rpx * var(--host-font-scale, 1));
}

.drawer-trigger {
  margin-top: 24rpx;
}

.drawer-action {
  display: block;
  width: 100%;
  margin: 18rpx 0 0;
  padding: 0;
  border: 0;
  color: #2d7950;
  background: transparent;
  font-size: calc(28rpx * var(--host-font-scale, 1));
  line-height: 1.4;
  text-align: left;
}

.drawer-action::after {
  display: none;
}

.page.theme-dark .drawer-content-desc {
  color: #b9c8c0;
}

.page.theme-dark .drawer-action {
  color: #8ed0a4;
}
