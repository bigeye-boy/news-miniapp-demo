.badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.badge-info {
  background: #eff6ff;
  color: #2563eb;
}

.badge-success {
  background: #ecfdf5;
  color: #059669;
}

.badge.theme-dark.badge-info {
  background: #1e3a5f;
  color: #bfdbfe;
}

.badge.theme-dark.badge-success {
  background: #164e3b;
  color: #a7f3d0;
}
